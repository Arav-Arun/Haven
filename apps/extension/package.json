{
  "name": "@haven/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "anon-assets": "node scripts/copy-anon-assets.mjs",
    "dev": "pnpm anon-assets && wxt",
    "build": "pnpm anon-assets && wxt build",
    "zip": "pnpm anon-assets && wxt zip",
    "zip:web": "pnpm zip && node scripts/zip-for-web.mjs",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@anon-rpc/browser-extension-harness": "0.4.0",
    "@haven/core": "workspace:*",
    "@haven/platform": "workspace:*",
    "@haven/types": "workspace:*",
    "@haven/ui": "workspace:*",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wxt": "^0.21.5"
  }
}
