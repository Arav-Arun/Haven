# The extension reads the same settings as the website, with the WXT_ prefix. Copy to .env and fill in.
# Nothing has a built-in default: a missing setting is shown in the popup.
WXT_APP_ORIGIN=https://haven.vercel.app
WXT_API_URL=
WXT_BEE_URL=
WXT_SEPOLIA_RPC_URL=
WXT_ARKIV_RPC_URL=
# nox works with Sepolia alone; nym and tor would also need a mainnet RPC.
WXT_PRIVATE_NETWORK=nox
WXT_DEMO_MODE=true
# Add-on F3: the address of the release key R (printed by `pnpm --filter @haven/core release publish`). The extension
# releases keys only to a Haven page whose files match a release R signed.
WXT_RELEASE_SIGNER=
