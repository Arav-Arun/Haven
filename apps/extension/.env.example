# The extension reads the same settings as the website, with the WXT_ prefix. Copy to .env and fill in.
# Nothing has a built-in default: a missing setting is shown in the popup.
WXT_APP_ORIGIN=https://cloakroom.vercel.app
WXT_API_URL=
WXT_BEE_URL=
WXT_SEPOLIA_RPC_URL=
WXT_ARKIV_RPC_URL=
# nox works with Sepolia alone; nym and tor would also need a mainnet RPC.
WXT_PRIVATE_NETWORK=nox
WXT_DEMO_MODE=true
# Address of the release key R that signs cloak.release entities (add-on F3). Pages are only "verified" against its
# releases, and keys go to a page only after it is verified.
WXT_RELEASE_SIGNER=
