    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@cloakroom/core": "workspace:*",
    "@cloakroom/platform": "workspace:*",
    "@cloakroom/types": "workspace:*",
    "@cloakroom/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "lucide-react": "^1.60.0",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.16",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
