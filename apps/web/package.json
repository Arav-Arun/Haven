{
  "name": "@cloakroom/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "anon-iframe": "node scripts/copy-anon-iframe.mjs",
    "dev": "pnpm anon-iframe && next dev",
