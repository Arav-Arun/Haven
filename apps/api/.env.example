# apps/api settings (copy to apps/api/.env). Every value is required: the server refuses to start without it.
PORT=8787
SEPOLIA_RPC_URL=
# Holds only ROLE_REGISTRAR on cloakroom.eth and rooms.cloakroom.eth, plus Sepolia ETH and tGLM for drips.
RELAYER_PRIVATE_KEY=
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=
BEE_URL=
POSTAGE_BATCH_ID=
ROOM_POW_DIFFICULTY=20
# Per drip, to K or K_room (never to a stealth address).
DRIP_SEPOLIA_WEI=3000000000000000
DRIP_ARKIV_WEI=20000000000000000
# Drips are sent together, so their timing doesn't link a room to the account that made it. The plan says 600.
DRIP_BATCH_SECONDS=600
