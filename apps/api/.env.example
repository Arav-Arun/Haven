# apps/api (Person A). The shared keys (RELAYER_PRIVATE_KEY, ROOM_POW_DIFFICULTY, DRIP_SEPOLIA_WEI, DRIP_ARKIV_WEI,
# BEE_URL, POSTAGE_BATCH_ID) are in the repo-root .env.example; these are the API's own. On Fly, set them all with
# `fly secrets set`; never commit a filled-in copy.
SEPOLIA_RPC_URL=
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=
PORT=8787
# drips: sent in one batch every DRIP_INTERVAL_SECONDS; never below the relayer's floor; daily budget per chain
DRIP_INTERVAL_SECONDS=600
RELAYER_FLOOR_WEI=50000000000000000
DRIP_DAILY_BUDGET_WEI=500000000000000000
# abuse limits per UTC day
CLAIM_DAILY_CAP=100
ROOM_DAILY_CAP=200
UPLOAD_QUOTA_BYTES=268435456
UPLOAD_DAILY_BYTES=4294967296
