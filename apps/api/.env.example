# apps/api settings (copy to apps/api/.env). Every value is required: the server refuses to start without it.
PORT=8787
SEPOLIA_RPC_URL=
# Holds only ROLE_REGISTRAR on haven.eth and rooms.haven.eth, plus Sepolia ETH and tGLM for drips.
RELAYER_PRIVATE_KEY=
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=
BEE_URL=
POSTAGE_BATCH_ID=
ROOM_POW_DIFFICULTY=20
# Per drip, to K or K_room (never to a stealth address).
DRIP_SEPOLIA_WEI=3000000000000000
DRIP_ARKIV_WEI=20000000000000000
# Drips are sent together, so their timing doesn't link a room to the account that made it. The plan says 600;
# 60 keeps "Try it" usable (a new room waits for its first drip).
DRIP_BATCH_SECONDS=60
# Add-on F4 (live updates): leading bits a doorbell chunk's address shares with our Bee node's overlay, so the node
# hears it. 12 is bee-js's default for GSOC mining. Leave empty to turn live updates off (apps re-read Arkiv every 30 s).
DOORBELL_PROXIMITY=12
