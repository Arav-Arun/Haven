{
  "name": "@cloakroom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy": "pnpm build && fly deploy"
  },
  "dependencies": {
    "@cloakroom/core": "workspace:*",
    "@cloakroom/types": "workspace:*",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
